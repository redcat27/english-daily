# english-daily 环境变量
# 用法：复制成 .env 再填值（.env 已被 git 忽略）
#   cp .env.example .env

# ---- Neon Postgres（复用 spring-smoke-80019025 / br-fancy-base-b3kbwvb0，独立 english schema）----
# 运行时用带 -pooler 的 pooled 串；Prisma 迁移用不带 -pooler 的 direct 串（两者密码相同）。
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.aws.neon.tech/neondb?sslmode=require&schema=english"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.aws.neon.tech/neondb?sslmode=require&schema=english"

# ---- MiniMax（生成次日课程 + 自然人声 TTS）----
# Key 只放服务端，绝不下发到浏览器。
MINIMAX_API_KEY=""
MINIMAX_BASE_URL="https://api.minimax.io"
MINIMAX_CHAT_MODEL="MiniMax-M2.5"
MINIMAX_TTS_MODEL="speech-2.8-turbo"
# 发音人：自然人声、语速正常
MINIMAX_VOICE_ID="English_expressive_narrator"
MINIMAX_VOICE_SPEED="1"


