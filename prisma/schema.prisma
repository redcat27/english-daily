// english-daily · Neon Postgres（复用现有库，独立 english schema）
//
// 存储策略（免费额度考虑）：
// - daily_lessons：只保留「当天」内容，新的一天生成时清掉更早的当日内容。
// - word_progress / review_events / feedbacks：长期保留，是 AI 迭代与记忆曲线的依据。
// - TTS 音频不落库，缓存在浏览器 IndexedDB。

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["english"]
}

model User {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  gender    String
  level     String   @default("A2")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons   DailyLesson[]
  words     WordProgress[]
  reviews   ReviewEvent[]
  feedbacks Feedback[]
  tasks     GenerationTask[]

  @@schema("english")
  @@map("users")
}

model DailyLesson {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  dayIndex  Int
  scene     String   @db.VarChar(60)
  title     String   @db.VarChar(120)
  level     String   @db.VarChar(10)
  payload   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@schema("english")
  @@map("daily_lessons")
}

model WordProgress {
  id        String   @id @default(cuid())
  userId    String
  word      String   @db.VarChar(80)
  phonetic  String   @db.VarChar(80) @default("")
  pos       String   @db.VarChar(20) @default("")
  meaning   String   @db.VarChar(160)
  example   String   @db.VarChar(300) @default("")
  exampleCn String   @db.VarChar(300) @default("")
  scene     String   @db.VarChar(60) @default("")
  box       Int      @default(1)
  hits      Int      @default(0)
  misses    Int      @default(0)
  graduated Boolean  @default(false)
  dueDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, word])
  @@index([userId, dueDate])
  @@schema("english")
  @@map("word_progress")
}

model GenerationTask {
  id         String    @id @default(cuid())
  userId     String
  taskKey    String    @db.VarChar(40)
  status     String    @db.VarChar(16)
  startedAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?
  error      String    @db.VarChar(300) @default("")
  summary    String    @db.VarChar(400) @default("")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskKey])
  @@index([userId, status])
  @@schema("english")
  @@map("generation_tasks")
}

model ReviewEvent {
  id        String   @id @default(cuid())
  userId    String
  word      String   @db.VarChar(80)
  result    String   @db.VarChar(10)
  boxBefore Int
  boxAfter  Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@schema("english")
  @@map("review_events")
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  shadowing Int
  reading   Int
  note      String   @db.VarChar(500) @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@schema("english")
  @@map("feedbacks")
}
